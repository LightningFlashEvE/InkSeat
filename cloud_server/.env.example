FRONTEND_PORT=8080

# MongoDB 容器初始化账号。密码建议只使用字母、数字、下划线，避免 URL 编码问题。
MONGO_INITDB_ROOT_USERNAME=esp32_epd_root
MONGO_INITDB_ROOT_PASSWORD=change_this_mongo_password
MONGODB_DB=esp32_epd

# 用于后端返回给设备的下载 URL。需要填写服务器公网 IP 或域名。
FLASK_HOST=your-server-ip-or-domain
FLASK_PORT=8080

SECRET_KEY=change_this_to_a_random_secret

# 和风天气 API Key（可选，用于天气模板）。在 https://dev.qweather.com/ 注册后免费获取。
QWEATHER_KEY=your-qweather-api-key

# 名单下发 AI 解析（可选）。Key 只给后端容器使用，不要写到前端页面。
# OpenAI:
# NAMEPLATE_AI_BASE_URL=https://api.openai.com/v1
# NAMEPLATE_AI_MODEL=gpt-4.1-mini
# NAMEPLATE_AI_API_MODE=responses
# 阿里云百炼/通义千问等 OpenAI 兼容接口通常使用 chat_completions 模式：
# NAMEPLATE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NAMEPLATE_AI_MODEL=qwen-vl-plus
# NAMEPLATE_AI_API_MODE=chat_completions
# MiniMax-M3 也可使用 chat_completions 模式，后端会自动关闭 thinking 以保证 JSON 易解析：
# NAMEPLATE_AI_BASE_URL=https://api.minimax.io/v1
# NAMEPLATE_AI_MODEL=MiniMax-M3
# NAMEPLATE_AI_API_MODE=chat_completions
NAMEPLATE_AI_API_KEY=
NAMEPLATE_AI_BASE_URL=https://api.openai.com/v1
NAMEPLATE_AI_MODEL=gpt-4.1-mini
NAMEPLATE_AI_API_MODE=responses

# 推荐仅绑定回环地址，并由宿主机 TLS 反向代理公开 443。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# 下列必填项故意留空；docker compose 会在未配置时拒绝启动。

# MongoDB 容器初始化账号。密码建议只使用字母、数字、下划线，避免 URL 编码问题。
MONGO_INITDB_ROOT_USERNAME=esp32_epd_root
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_DB=esp32_epd

# 旧版回退字段；新部署仍填写，便于手动运行旧脚本。
FLASK_HOST=
FLASK_PORT=8080

# 后端返回给设备的绝对下载地址，必须是无路径的 http(s) origin。
# 生产环境推荐 HTTPS，并与固件 CLOUD_API_HOST/CLOUD_API_PORT/CLOUD_API_USE_HTTPS 保持一致。
PUBLIC_BASE_URL=

SECRET_KEY=

# 首次管理员注册令牌，至少32个随机字符；首个账号创建后不再接受公网注册。
ADMIN_BOOTSTRAP_TOKEN=
ALLOW_REGISTRATION=false
AUTH_TOKEN_TTL_SECONDS=604800

# 同源部署留空；仅前后端跨域部署时填逗号分隔的精确 HTTPS origin。
CORS_ORIGINS=

# 设备身份与配对防护。生产环境保持 DEVICE_AUTH_REQUIRED=true。
DEVICE_AUTH_REQUIRED=true
PAIRING_MAX_FAILED_ATTEMPTS=8
PAIRING_LOCK_SECONDS=900
DEVICE_STATUS_MAX_BODY_BYTES=4096
DEVICE_KEY_RESET_WINDOW_SECONDS=300
# 从未绑定过的 TOFU 身份保留时间；设备每次唤醒会续期，曾绑定设备不受影响。
UNCLAIMED_DEVICE_TTL_SECONDS=172800

# 和风天气 API Key（可选，用于天气模板）。在 https://dev.qweather.com/ 注册后免费获取。
QWEATHER_KEY=

# 名单下发 AI 解析（可选）。Key 只给后端容器使用，不要写到前端页面。
# OpenAI:
# NAMEPLATE_AI_BASE_URL=https://api.openai.com/v1
# NAMEPLATE_AI_MODEL=gpt-4.1-mini
# NAMEPLATE_AI_API_MODE=responses
# 阿里云百炼/通义千问等 OpenAI 兼容接口通常使用 chat_completions 模式：
# NAMEPLATE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NAMEPLATE_AI_MODEL=qwen-vl-plus
# NAMEPLATE_AI_API_MODE=chat_completions
# MiniMax-M3 也可使用 chat_completions 模式，后端会自动关闭 thinking 以保证 JSON 易解析：
# NAMEPLATE_AI_BASE_URL=https://api.minimax.io/v1
# NAMEPLATE_AI_MODEL=MiniMax-M3
# NAMEPLATE_AI_API_MODE=chat_completions
NAMEPLATE_AI_API_KEY=
NAMEPLATE_AI_BASE_URL=https://api.openai.com/v1
NAMEPLATE_AI_MODEL=gpt-4.1-mini
NAMEPLATE_AI_API_MODE=responses
